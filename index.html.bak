<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#263449" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#15130E" media="(prefers-color-scheme: dark)">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="ทำเนียบ 268">
<meta name="format-detection" content="telephone=no">
<link rel="apple-touch-icon" href="data:image/png;base64,">
<link rel="icon" href="data:image/png;base64,">
<link rel="manifest" href="data:application/manifest+json;base64,">
<title>ทำเนียบรุ่น 268 · ค้นหารายชื่อ</title>
<style>
@font-face{font-family:"Sarabun V";src:url(data:font/woff2;base64,) format("woff2");font-weight:400;font-style:normal;font-display:swap;}
@font-face{font-family:"Sarabun V";src:url(data:font/woff2;base64,) format("woff2");font-weight:500;font-style:normal;font-display:swap;}
@font-face{font-family:"Sarabun V";src:url(data:font/woff2;base64,) format("woff2");font-weight:600;font-style:normal;font-display:swap;}
@font-face{font-family:"Kanit V";src:url(data:font/woff2;base64,) format("woff2");font-weight:600;font-style:normal;font-display:swap;}
@font-face{font-family:"Kanit V";src:url(data:font/woff2;base64,) format("woff2");font-weight:700;font-style:normal;font-display:swap;}
@font-face{font-family:"Mono V";src:url(data:font/woff2;base64,) format("woff2");font-weight:500;font-style:normal;font-display:swap;}

:root{
  --bg:#F5F1E7;
  --surface:#FDFAF3;
  --surface-raised:#FFFFFF;
  --ink:#221D15;
  --muted:#6E6553;
  --faint:#948A72;
  --accent:#8A6A2E;
  --accent-ink:#FFFFFF;
  --accent-soft:#EDE1C6;
  --navy:#263449;
  --navy-ink:#EDE7D8;
  --line:#E3DCC8;
  --good:#3F7A4F;
  --shadow:0 1px 2px rgba(45,35,10,.06), 0 6px 20px -8px rgba(45,35,10,.18);
  --radius-lg:20px;
  --radius-md:14px;
  --radius-sm:9px;
  color-scheme:light;
}
@media (prefers-color-scheme: dark){
  :root{
    --bg:#15130E; --surface:#1D1911; --surface-raised:#241F16; --ink:#F2EDE0; --muted:#A79C87;
    --faint:#7C7360; --accent:#D6AC5C; --accent-ink:#221A0C; --accent-soft:#3A2F1B; --navy:#3E5470;
    --navy-ink:#EDE7D8; --line:#332C1F; --good:#6FBF83;
    --shadow:0 1px 2px rgba(0,0,0,.3), 0 10px 26px -10px rgba(0,0,0,.55);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#15130E; --surface:#1D1911; --surface-raised:#241F16; --ink:#F2EDE0; --muted:#A79C87;
  --faint:#7C7360; --accent:#D6AC5C; --accent-ink:#221A0C; --accent-soft:#3A2F1B; --navy:#3E5470;
  --navy-ink:#EDE7D8; --line:#332C1F; --good:#6FBF83;
  --shadow:0 1px 2px rgba(0,0,0,.3), 0 10px 26px -10px rgba(0,0,0,.55);
  color-scheme:dark;
}
:root[data-theme="light"]{
  --bg:#F5F1E7; --surface:#FDFAF3; --surface-raised:#FFFFFF; --ink:#221D15; --muted:#6E6553;
  --faint:#948A72; --accent:#8A6A2E; --accent-ink:#FFFFFF; --accent-soft:#EDE1C6; --navy:#263449;
  --navy-ink:#EDE7D8; --line:#E3DCC8; --good:#3F7A4F;
  --shadow:0 1px 2px rgba(45,35,10,.06), 0 6px 20px -8px rgba(45,35,10,.18);
  color-scheme:light;
}

*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  background:var(--bg); color:var(--ink);
  font-family:"Sarabun V","Sarabun",-apple-system,"Noto Sans Thai","Leelawadee UI",sans-serif;
  -webkit-font-smoothing:antialiased; overflow-x:hidden; min-height:100vh;
  padding-bottom:env(safe-area-inset-bottom);
}
h1,h2,h3{font-family:"Kanit V","Kanit","Sarabun V",sans-serif;text-wrap:balance;margin:0;}
.mono{font-family:"Mono V","JetBrains Mono",ui-monospace,monospace;font-variant-numeric:tabular-nums;}
button{font:inherit;color:inherit;}
a{color:inherit;}
::selection{background:var(--accent-soft);}

.wrap{max-width:560px;margin:0 auto;position:relative;min-height:100vh;}

/* ---------- header ---------- */
header{
  position:sticky;top:0;z-index:20;background:var(--bg);
  padding:calc(14px + env(safe-area-inset-top)) 16px 12px;border-bottom:1px solid var(--line);
}
.brand{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:4px;}
.brand h1{font-size:20px;font-weight:600;letter-spacing:.2px;}
.brand-right{display:flex;align-items:center;gap:8px;}
.count{
  font-family:"Mono V",monospace;font-size:12px;color:var(--navy-ink);
  background:var(--navy);padding:3px 9px;border-radius:100px;white-space:nowrap;
}
.icon-btn{
  flex:none;width:32px;height:32px;border-radius:50%;border:1px solid var(--line);
  background:var(--surface-raised);display:flex;align-items:center;justify-content:center;
  color:var(--muted);cursor:pointer;
}
.icon-btn:active{transform:scale(.94);}
.subtitle{font-size:12.5px;color:var(--muted);margin-bottom:12px;}

.searchbar{
  position:relative;display:flex;align-items:center;
  background:var(--surface-raised);border:1px solid var(--line);border-radius:100px;
  box-shadow:var(--shadow);padding:0 6px 0 14px;height:46px;
}
.searchbar svg{flex:none;color:var(--faint);}
.searchbar input{
  flex:1;border:0;background:none;outline:none;color:var(--ink);
  font-family:"Sarabun V",sans-serif;font-size:15.5px;padding:0 8px;height:100%;
}
.searchbar input::placeholder{color:var(--faint);}
.clear-btn{
  flex:none;border:0;background:var(--line);color:var(--muted);
  width:26px;height:26px;border-radius:50%;display:none;align-items:center;justify-content:center;cursor:pointer;
}
.clear-btn.show{display:flex;}

.hint{
  display:flex;align-items:center;gap:9px;margin-top:10px;padding:9px 12px;border-radius:var(--radius-sm);
  background:var(--accent-soft);color:var(--ink);font-size:12.5px;line-height:1.4;animation:fade-in .3s ease;
}
.hint b{font-weight:600;}
.hint .x{margin-left:auto;flex:none;background:none;border:0;color:var(--muted);padding:4px;cursor:pointer;font-size:15px;line-height:1;}
@keyframes fade-in{from{opacity:0;transform:translateY(-4px);}to{opacity:1;transform:translateY(0);}}

/* ---------- list ---------- */
main{padding:10px 12px 28px;}
.empty{display:flex;flex-direction:column;align-items:center;gap:10px;padding:64px 20px;color:var(--muted);text-align:center;}
.empty svg{color:var(--faint);}
.empty .t1{font-family:"Kanit V";font-size:16px;color:var(--ink);font-weight:600;}
.empty .t2{font-size:13px;}

.list{display:flex;flex-direction:column;gap:8px;}
.card{
  display:flex;align-items:center;gap:12px;
  background:var(--surface-raised);border:1px solid var(--line);border-radius:var(--radius-md);
  padding:9px 11px;cursor:pointer;text-align:right;
  transition:transform .12s ease, box-shadow .12s ease;
}
.card:active{transform:scale(.985);}
@media(hover:hover){.card:hover{box-shadow:var(--shadow);}}

.thumb-wrap{position:relative;flex:none;}
.thumb{
  display:block;width:64px;height:85px;border-radius:11px;object-fit:cover;
  background:var(--line);border:1px solid var(--line);
}
.edited-dot{
  position:absolute;top:-3px;right:-3px;width:14px;height:14px;border-radius:50%;
  background:var(--good);border:2px solid var(--surface-raised);display:none;
}
.edited-dot.show{display:block;}

.card-mid{flex:1;min-width:0;text-align:left;}
.name-row{display:flex;align-items:baseline;gap:6px;flex-wrap:wrap;}
.rank{font-size:11px;color:var(--faint);font-weight:400;}
.name{font-size:15.5px;font-weight:600;color:var(--ink);}
.nick{font-size:12.5px;color:var(--accent);font-weight:500;}
.pos{font-size:12px;color:var(--muted);margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.tag-row{display:flex;gap:5px;margin-top:5px;flex-wrap:wrap;}
.tag{
  font-size:10.5px;color:var(--muted);background:var(--bg);border:1px solid var(--line);
  border-radius:6px;padding:1.5px 6px;line-height:1.5;white-space:nowrap;
}
mark{background:var(--accent-soft);color:var(--ink);border-radius:3px;padding:0 1px;}

.card-side{flex:none;display:flex;flex-direction:column;align-items:flex-end;gap:5px;}
.no-badge{font-size:11px;color:var(--navy-ink);background:var(--navy);border-radius:6px;padding:1px 6px;}
.phone{font-size:13px;color:var(--ink);letter-spacing:.2px;}

.count-line{padding:2px 4px 12px;font-size:12px;color:var(--faint);}

footer{
  text-align:center;padding:22px 20px calc(20px + env(safe-area-inset-bottom));
  color:var(--faint);font-size:11.5px;line-height:1.7;border-top:1px solid var(--line);margin-top:6px;
}
footer button.linklike{
  background:none;border:0;color:var(--muted);text-decoration:underline;font-size:11.5px;
  font-family:inherit;cursor:pointer;padding:0;
}

/* ---------- sheet (shared: detail view / edit form / settings) ---------- */
.backdrop{
  position:fixed;inset:0;background:rgba(20,16,8,.45);backdrop-filter:blur(2px);
  opacity:0;pointer-events:none;transition:opacity .22s ease;z-index:30;
}
.backdrop.show{opacity:1;pointer-events:auto;}

.sheet{
  position:fixed;left:0;right:0;bottom:0;z-index:31;max-width:560px;margin:0 auto;
  background:var(--surface);border-radius:22px 22px 0 0;
  box-shadow:0 -10px 40px -6px rgba(0,0,0,.35);
  padding:10px 20px calc(22px + env(safe-area-inset-bottom));
  transform:translateY(105%);transition:transform .28s cubic-bezier(.32,.72,0,1);
  max-height:90vh;overflow-y:auto;
}
.sheet.show{transform:translateY(0);}
.grabber{width:36px;height:4px;border-radius:3px;background:var(--line);margin:2px auto 14px;}

.sheet-topbar{display:flex;justify-content:flex-end;gap:6px;margin-bottom:2px;}

.sheet-head{display:flex;gap:14px;align-items:center;margin-bottom:14px;}
.sheet-photo{
  width:100px;height:133px;border-radius:16px;object-fit:cover;flex:none;
  border:1px solid var(--line);background:var(--line);
}
.sheet-id{
  font-family:"Mono V";font-size:12px;color:var(--navy-ink);background:var(--navy);
  display:inline-block;padding:2px 8px;border-radius:6px;margin-bottom:6px;
}
.sheet-name{font-size:19px;font-weight:600;line-height:1.3;}
.sheet-nick{font-size:13.5px;color:var(--accent);font-weight:500;margin-top:2px;}

.detail-rows{display:flex;flex-direction:column;gap:0;border-top:1px solid var(--line);margin-top:4px;}
.drow{display:flex;gap:12px;padding:12px 0;border-bottom:1px solid var(--line);align-items:flex-start;}
.drow .k{flex:none;width:64px;font-size:12px;color:var(--faint);padding-top:2px;}
.drow .v{flex:1;font-size:14.5px;line-height:1.55;}
.drow .v.phone-v{font-family:"Mono V";letter-spacing:.3px;}

.actions{display:flex;gap:10px;margin-top:18px;}
.btn{
  flex:1;display:flex;align-items:center;justify-content:center;gap:8px;
  height:48px;border-radius:100px;border:0;font-size:15px;font-weight:600;cursor:pointer;
  font-family:"Sarabun V",sans-serif;
}
.btn-primary{background:var(--accent);color:var(--accent-ink);}
.btn-ghost{background:var(--surface-raised);color:var(--ink);border:1px solid var(--line);}
.btn-sm{height:40px;font-size:13.5px;}
.btn:active{transform:scale(.97);}

/* edit form */
.edit-photo-row{display:flex;justify-content:center;margin-bottom:18px;}
.edit-photo-btn{position:relative;border:0;background:none;padding:0;cursor:pointer;}
.edit-photo-btn img{
  width:120px;height:160px;border-radius:18px;object-fit:cover;border:1px solid var(--line);
  background:var(--line);display:block;
}
.edit-photo-overlay{
  position:absolute;bottom:6px;right:6px;width:34px;height:34px;border-radius:50%;
  background:var(--accent);color:var(--accent-ink);display:flex;align-items:center;justify-content:center;
  border:2px solid var(--surface);
}
.field{margin-bottom:14px;}
.field label{display:block;font-size:12px;color:var(--faint);margin-bottom:5px;}
.field input{
  width:100%;height:44px;border-radius:11px;border:1px solid var(--line);background:var(--surface-raised);
  color:var(--ink);font-family:"Sarabun V",sans-serif;font-size:14.5px;padding:0 13px;outline:none;
}
.field input:focus{border-color:var(--accent);}
.field-row{display:flex;gap:10px;}
.field-row .field{flex:1;}
.revert-link{
  display:block;margin:2px 0 16px;background:none;border:0;color:var(--muted);text-decoration:underline;
  font-size:12.5px;font-family:inherit;cursor:pointer;padding:0;
}

/* settings sheet */
.settings-item{
  display:flex;align-items:center;gap:12px;padding:14px 2px;border-bottom:1px solid var(--line);
  cursor:pointer;background:none;border-left:0;border-right:0;border-top:0;width:100%;text-align:left;
  color:var(--ink);font-family:"Sarabun V",sans-serif;
}
.settings-item svg{flex:none;color:var(--muted);}
.settings-item .t{flex:1;}
.settings-item .t .tt{font-size:14.5px;font-weight:500;}
.settings-item .t .td{font-size:12px;color:var(--muted);margin-top:1px;}
.settings-note{
  font-size:12px;color:var(--muted);line-height:1.6;background:var(--accent-soft);
  border-radius:var(--radius-sm);padding:10px 12px;margin-top:14px;
}

.toast{
  position:fixed;left:50%;bottom:26px;transform:translate(-50%,12px);
  background:var(--ink);color:var(--bg);padding:10px 18px;border-radius:100px;
  font-size:13px;opacity:0;pointer-events:none;transition:all .25s ease;z-index:40;
  box-shadow:0 8px 24px -6px rgba(0,0,0,.4);max-width:85vw;text-align:center;
}
.toast.show{opacity:1;transform:translate(-50%,0);}

@media (prefers-reduced-motion: reduce){
  *{animation-duration:.001ms !important;transition-duration:.001ms !important;}
}
</style>

<div class="wrap">
  <header>
    <div class="brand">
      <h1>ทำเนียบรุ่น 268</h1>
      <div class="brand-right">
        <span class="count mono" id="countBadge">154 นาย</span>
        <button class="icon-btn" id="settingsBtn" aria-label="ตั้งค่าและจัดการข้อมูล">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </button>
      </div>
    </div>
    <div class="subtitle">หลักสูตรสารวัตร วิทยาลัยการตำรวจ · 13 ก.ค. – 18 ก.ย. 2569</div>
    <div class="searchbar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      <input id="search" type="text" inputmode="search" autocomplete="off" placeholder="ค้นหาชื่อ, ลำดับ, เบอร์โทร, หน่วย…">
      <button class="clear-btn" id="clearBtn" aria-label="ล้างคำค้นหา">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <div class="hint" id="installHint">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M12 5v11M7 12l5 5 5-5"/><path d="M5 19h14"/></svg>
      <span><b>ติดตั้งเป็นแอป:</b> แตะปุ่มแชร์ แล้วเลือก "เพิ่มไปยังหน้าจอโฮม"</span>
      <button class="x" id="hintClose" aria-label="ปิด">✕</button>
    </div>
  </header>

  <main>
    <div class="count-line" id="countLine"></div>
    <div class="list" id="list"></div>
    <div class="empty" id="empty" style="display:none">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      <div class="t1">ไม่พบรายชื่อที่ค้นหา</div>
      <div class="t2">ลองค้นด้วยชื่อ ชื่อเล่น เบอร์โทร หรือชื่อหน่วย</div>
    </div>
  </main>

  <footer>
    ทำเนียบหลักสูตรสารวัตร รุ่นที่ 268 · วิทยาลัยการตำรวจ กองบัญชาการศึกษา<br>
    ค้นหาได้ทั้งชื่อ ชื่อเล่น ยศ ตำแหน่ง หน่วยงาน และเบอร์โทรศัพท์
  </footer>
</div>

<div class="backdrop" id="backdrop"></div>
<div class="sheet" id="sheet" role="dialog" aria-modal="true">
  <div class="grabber"></div>
  <div id="sheetBody"></div>
</div>
<div class="toast" id="toast"></div>
<input type="file" id="photoInput" accept="image/*" style="display:none">
